BACKUP_ENCRYPTION_KEY=32-byte-hex-encoded-aes-gcm-master-key
BACKUP_CRON_SCHEDULE="0 2 * * *" # Daily at 02:00 UTC
BACKUP_RETENTION_DAYS=30

